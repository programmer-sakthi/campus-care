generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  STUDENT
  COUNSELLOR
  INSTITUTION
}

model User {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String

  type UserType

  studentRegNo    String? @unique
  counsellorEmail String? @unique
  institutionCode String? @unique

  student Student? @relation(fields: [studentRegNo], references: [regNo], onDelete: Cascade)

  counsellor Counsellor? @relation(fields: [counsellorEmail], references: [email], onDelete: Cascade)

  institution Institution? @relation(fields: [institutionCode], references: [code], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Institution {
  code  String  @id
  email String  @unique
  name  String?

  counsellors InstitutionCounsellor[]
  students    Student[]
  user        User?
}

model Student {
  regNo String  @id
  name  String?
  email String? @unique

  institutionCode String
  institution     Institution @relation(fields: [institutionCode], references: [code])

  appointments    Appointment[]
  dailyCheckIns   DailyCheckIn[]
  emotionalAudits EmotionalAudit[]

  conversations Conversation[]

  chatbotChats ChatbotChat[]

  user User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Counsellor {
  email String  @id
  name  String?

  institutions InstitutionCounsellor[]
  appointments Appointment[]

  conversations Conversation[]

  user      User?
  createdAt DateTime @default(now())
}

enum CounsellorInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  LEFT
}

model InstitutionCounsellor {
  institutionCode String
  counsellorEmail String

  status CounsellorInvitationStatus @default(PENDING)

  noOfSessions Int @default(0)

  invitedAt DateTime  @default(now())
  joinedAt  DateTime?

  institution Institution @relation(fields: [institutionCode], references: [code])

  counsellor Counsellor @relation(fields: [counsellorEmail], references: [email])

  @@id([institutionCode, counsellorEmail])
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model Appointment {
  id String @id @default(cuid())

  studentRegNo    String
  counsellorEmail String

  reason String

  status AppointmentStatus @default(PENDING)

  scheduledAt     DateTime?
  durationMinutes Int       @default(30)

  rejectionReason String?
  sessionNote     String?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  completedAt DateTime?

  student Student @relation(fields: [studentRegNo], references: [regNo])

  counsellor Counsellor @relation(fields: [counsellorEmail], references: [email])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MessageSenderType {
  STUDENT
  COUNSELLOR
}

model Conversation {
  id String @id @default(cuid())

  studentRegNo    String
  counsellorEmail String

  student Student @relation(fields: [studentRegNo], references: [regNo], onDelete: Cascade)

  counsellor Counsellor @relation(fields: [counsellorEmail], references: [email], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentRegNo, counsellorEmail])
  @@index([studentRegNo])
  @@index([counsellorEmail])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  senderType     MessageSenderType

  content String @db.Text

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
}

enum MoodTime {
  MORNING
  EVENING
  NIGHT
}

enum Mood {
  VERY_BAD
  BAD
  NEUTRAL
  GOOD
  VERY_GOOD
}

model DailyCheckIn {
  id String @id @default(cuid())

  studentRegNo String

  student Student @relation(fields: [studentRegNo], references: [regNo], onDelete: Cascade)

  date DateTime @db.Date

  note String? @db.Text

  // Answers and model guidance belong to the same dated check-in. Keeping
  // them as JSON makes the check-in form extensible without turning each
  // wording change into a database migration.
  answers Json?
  insights Json?

  mentalHealthScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moods     MoodEntry[]
  responses QuestionResponse[]

  @@unique([studentRegNo, date])
  @@index([studentRegNo, date])
}

model MoodEntry {
  id String @id @default(cuid())

  dailyCheckInId String

  dailyCheckIn DailyCheckIn @relation(fields: [dailyCheckInId], references: [id], onDelete: Cascade)

  time MoodTime
  mood Mood

  createdAt DateTime @default(now())

  @@unique([dailyCheckInId, time])
  @@index([dailyCheckInId])
}

model CheckInQuestion {
  id String @id @default(cuid())

  question String
  active   Boolean @default(true)

  responses QuestionResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionResponse {
  id String @id @default(cuid())

  dailyCheckInId String

  dailyCheckIn DailyCheckIn @relation(fields: [dailyCheckInId], references: [id], onDelete: Cascade)

  questionId String

  question CheckInQuestion @relation(fields: [questionId], references: [id])

  answer String @db.Text

  createdAt DateTime @default(now())

  @@unique([dailyCheckInId, questionId])
  @@index([dailyCheckInId])
}

enum ChatbotRole {
  USER
  ASSISTANT
}

enum RiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// One continuous "Emora" companion thread per student. Long-term facts
// extracted from these messages live in ml-service's vector DB (keyed by
// studentRegNo), not here — this table is just the durable message log.
enum ConcernLevel {
  LOW
  MODERATE
  HIGH
}

// A longer, periodic (every 10 days) structured mental-health screening —
// distinct from the lightweight `DailyCheckIn`. Domain-level scoring is
// computed deterministically in the backend (never trust the client); the
// LLM in ml-service only turns those numbers into grounded, supportive
// language. `safetyTriggered` is derived purely from the Section G answers
// and is never gated behind the LLM call — see `emotional-audit.router.ts`.
model EmotionalAudit {
  id String @id @default(cuid())

  studentRegNo String
  student      Student @relation(fields: [studentRegNo], references: [regNo], onDelete: Cascade)

  // Raw answers, keyed by question id (q1..q29). Kept as JSON so the
  // question bank can evolve without a migration for every wording change.
  answers Json

  // Per-domain concern score, 0-100 (higher = more concern). Keyed by
  // domain id, e.g. { "mood": 42, "anxiety": 68, ... }.
  domainScores Json

  overallScore    Int
  overallCategory ConcernLevel

  // Supportive, non-diagnostic recommendations from ml-service. Empty when
  // `safetyTriggered` is true — the safety response is static, not model
  // generated.
  insights Json

  safetyTriggered Boolean @default(false)

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([studentRegNo, submittedAt])
}

model ChatbotChat {
  id String @id @default(cuid())

  studentRegNo String
  student      Student @relation(fields: [studentRegNo], references: [regNo], onDelete: Cascade)

  title    String           @default("New chat")
  messages ChatbotMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentRegNo, updatedAt])
}

model ChatbotMessage {
  id String @id @default(cuid())

  chatId String
  chat   ChatbotChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role    ChatbotRole
  content String      @db.Text

  riskLevel RiskLevel @default(NONE)

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}
