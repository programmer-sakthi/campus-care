// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  code  String  @id
  email String  @unique
  name  String?

  counsellors InstitutionCounsellor[]
  students    Student[]
}

model Student {
  regNo String  @id
  name  String?
  email String? @unique

  institutionCode String
  institution     Institution @relation(fields: [institutionCode], references: [code])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Counsellor {
  email String  @id
  name  String?
  createdAt DateTime @default(now())

  institutions InstitutionCounsellor[]
}

enum CounsellorInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  LEFT
}

model InstitutionCounsellor {
  institutionCode String
  counsellorEmail String
  status          CounsellorInvitationStatus @default(PENDING)

  noOfSessions Int @default(0)

  invitedAt DateTime  @default(now())
  joinedAt  DateTime?

  institution Institution @relation(fields: [institutionCode], references: [code])

  counsellor Counsellor @relation(fields: [counsellorEmail], references: [email])

  @@id([institutionCode, counsellorEmail])
}
